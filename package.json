{
  "name": "octobase",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:safari": "pnpm build:safari",
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:all": "pnpm --parallel --stream run dev:safari dev:chrome dev:firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "build:all": "pnpm build && pnpm build:firefox && pnpm build:safari",
    "package:safari": "pnpm build:safari && node tools/safari/prepare.mjs",
    "package:safari:direct": "pnpm build:safari && node tools/safari/prepare.mjs --channel direct",
    "open:safari": "pnpm package:safari && open .output/safari-xcode/Octobase/Octobase.xcodeproj",
    "sync:safari": "pnpm build:safari && rsync -a --delete .output/safari-mv3/ '.output/safari-xcode/Octobase/Octobase Extension/Resources/'",
    "check:safari": "pnpm package:safari && node tools/safari/check.mjs",
    "check:safari:direct": "pnpm package:safari:direct && node tools/safari/check.mjs --channel direct",
    "archive:safari": "pnpm package:safari && node tools/safari/archive.mjs",
    "archive:safari:direct": "pnpm package:safari:direct && node tools/safari/archive.mjs --channel direct",
    "export:safari": "node tools/safari/export.mjs --channel direct",
    "notarize:safari": "node tools/safari/notarize.mjs --channel direct",
    "release:safari": "pnpm archive:safari:direct && pnpm export:safari && pnpm notarize:safari",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "size": "node tools/size/check-bundle-size.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.3.0",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@octokit/graphql-schema": "^15.26.1",
    "@oxlint/plugins": "1.79.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "oxfmt": "0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,jsonc,md,yml,yaml}": [
      "oxfmt"
    ],
    "*.{ts,tsx}": [
      "oxlint --deny-warnings"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.3.0"
}
